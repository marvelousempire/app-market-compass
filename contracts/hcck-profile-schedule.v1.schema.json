{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market Compass draft Hybrid CCK profile schedule",
  "description": "Local domain projection only. CCK That and Schema That Studio remain authoritative; this schema is not indexed, certified, deployed, or a source permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "subject_kind",
    "domain",
    "source_owner",
    "fields",
    "schedule",
    "example_metrics",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "source_owner": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "cadence",
        "timestamp",
        "timezone",
        "evidence_required",
        "automatic_job"
      ],
      "properties": {
        "clock": {
          "enum": [
            "event",
            "calendar"
          ]
        },
        "cadence": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "const": "observation.at"
        },
        "timezone": {
          "const": "UTC"
        },
        "evidence_required": {
          "type": "boolean"
        },
        "automatic_job": {
          "const": false
        }
      }
    },
    "example_metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
